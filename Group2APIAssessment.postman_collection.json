  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "requests": {},
        "exec": [
          "// Skip auto-login for login & registration",
          "if (['AdminLogin', 'userRegistration'].includes(pm.info.requestName)) return;",
          "",
          "const token = pm.collectionVariables.get('adminToken');",
          "if (token) {",
          "    try {",
          "        const payload = JSON.parse(atob(token.split('.')[1]));",
          "        const now = Math.floor(Date.now() / 1000);",
          "        if (payload.exp > now + 60) return; // Valid with 60s buffer",
          "    } catch(e) {}",
          "}",
          "",
          "// Fetch new token",
          "pm.sendRequest({",
          "    url: 'https://www.ndosiautomation.co.za/APIDEV/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json', 'accept': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ email: 'admin@gmail.com', password: '@12345678' }) }",
          "}, (err, res) => {",
          "    if (err) return console.error('❌ Auto-login failed:', err);",
          "    const data = res.json();",
          "    const newToken = data.token || data.accessToken || (data.data && data.data.token);",
          "    if (newToken) {",
          "        pm.collectionVariables.set('adminToken', newToken);",
          "        console.log('🔄 Token refreshed automatically');",
          "    } else {",
          "        console.error('❌ Could not extract token from login response');",
          "    }",
          "});"
        ]
      }
    },
